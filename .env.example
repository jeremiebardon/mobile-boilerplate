# Auth0 Configuration
# Replace these with your Auth0 Native Application credentials from the Auth0 Dashboard
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-client-id

# Observability / Sentry Configuration
EXPO_PUBLIC_OBSERVABILITY_PROVIDER=sentry
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0
